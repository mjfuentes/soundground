# SoundGround environment configuration
# Copy to .env and fill in. There are NO built-in fallback credentials:
# without configuration, every SoundCloud call fails loudly by design.

# --- SoundCloud official API (PRIMARY — required for normal operation) ------
# Register the app (needs an Artist Pro account):
#   https://developers.soundcloud.com/docs/api/register-app
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# --- Unofficial api-v2 fallback (OPTIONAL, opt-in) --------------------------
# A soundcloud.com web client_id you supply yourself. Only used when set.
# Also enables the api-v2-only extras (profile spotlight section).
# SOUNDCLOUD_APIV2_CLIENT_ID=

# --- Sessions (OPTIONAL — user accounts are currently parked) ---------------
# Only needed if the user-OAuth flow is restored from attic/. No default:
# session operations throw when unset.
# JWT_SECRET=

# --- Misc (OPTIONAL) --------------------------------------------------------
# SQLite cache location (defaults to ./data/cache.db; use ":memory:" in tests)
# CACHE_DB_PATH=
# Public base URL of the deployment
# NEXT_PUBLIC_BASE_URL=
