{
  "name": "soundground",
  "version": "0.1.0",
  "private": true,
  "description": "SoundGround - Sounds from the Underground. Discover and explore SoundCloud artists.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "prepare": "husky",
    "crawl": "node --env-file-if-exists=.env --import tsx scripts/crawl.ts",
    "aggregate": "node --env-file-if-exists=.env --import tsx scripts/aggregate.ts",
    "validate:env": "node scripts/validate-env.js",
    "validate:deployment": "node scripts/validate-deployment.js",
    "deploy:check": "node scripts/pre-deploy-check.js",
    "deploy:fly": "flyctl deploy --remote-only",
    "deploy": "npm run deploy:check && npm run deploy:fly"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "better-sqlite3": "^11.8.1",
    "cheerio": "^1.1.2",
    "got": "^14.4.9",
    "hls.js": "^1.6.13",
    "jose": "^6.1.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.2.3",
    "tailwindcss": "^4",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
