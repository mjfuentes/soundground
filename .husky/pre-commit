#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Run lint-staged (auto-fix)
npx lint-staged

# Type check
echo "📝 Type checking..."
npm run type-check

# Run tests (fast, no coverage)
echo "🧪 Running tests..."
npm test -- --passWithNoTests --bail --silent --onlyChanged

echo "✅ All checks passed!"
echo "💡 Build check will run in CI pipeline"
