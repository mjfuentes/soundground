#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Run lint-staged
npx lint-staged

# Type check
echo "📝 Type checking..."
npm run type-check

# Run tests
echo "🧪 Running tests..."
npm test -- --passWithNoTests --bail

# Build check
echo "🏗️  Testing build..."
npm run build

echo "✅ All checks passed!"
